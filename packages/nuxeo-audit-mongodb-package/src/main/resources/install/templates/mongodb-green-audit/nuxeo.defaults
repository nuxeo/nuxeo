## DO NOT EDIT THIS FILE, USE nuxeo.conf  ##
mongodb-green-audit.target=.

nuxeo.template.includes=mongodb

# blue/green audit migration deployed when choosing a green collection name
nuxeo.audit.backend.green.mongodb.collection.name=

nuxeo.audit.backend.green.mongodb.server=${nuxeo.audit.backend.default.mongodb.server}
nuxeo.audit.backend.green.mongodb.dbname=${nuxeo.audit.backend.default.mongodb.dbname}
nuxeo.audit.backend.green.mongodb.ssl=${nuxeo.audit.backend.default.mongodb.ssl}
nuxeo.audit.backend.green.mongodb.truststore.path=${nuxeo.audit.backend.default.mongodb.truststore.path}
nuxeo.audit.backend.green.mongodb.truststore.password=${nuxeo.audit.backend.default.mongodb.truststore.password}
nuxeo.audit.backend.green.mongodb.truststore.type=${nuxeo.audit.backend.default.mongodb.truststore.type}
nuxeo.audit.backend.green.mongodb.keystore.path=${nuxeo.audit.backend.default.mongodb.keystore.path}
nuxeo.audit.backend.green.mongodb.keystore.password=${nuxeo.audit.backend.default.mongodb.keystore.password}
nuxeo.audit.backend.green.mongodb.keystore.type=${nuxeo.audit.backend.default.mongodb.keystore.type}

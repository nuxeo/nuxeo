## DO NOT EDIT THIS FILE, USE nuxeo.conf  ##
opensearch1-green-audit.target=.

nuxeo.template.includes=common

# blue/green audit migration deployed when choosing a green index name
nuxeo.audit.backend.green.opensearch1.index.name=

nuxeo.audit.backend.green.opensearch1.client.server=${nuxeo.audit.backend.default.opensearch1.client.server}
nuxeo.audit.backend.green.opensearch1.client.connectionTimeout=${nuxeo.audit.backend.default.opensearch1.client.connectionTimeout}
nuxeo.audit.backend.green.opensearch1.client.socketTimeout=${nuxeo.audit.backend.default.opensearch1.client.socketTimeout}
nuxeo.audit.backend.green.opensearch1.client.sslCertificateVerification=${nuxeo.audit.backend.default.opensearch1.client.sslCertificateVerification}
nuxeo.audit.backend.green.opensearch1.client.username=${nuxeo.audit.backend.default.opensearch1.client.username}
nuxeo.audit.backend.green.opensearch1.client.password=${nuxeo.audit.backend.default.opensearch1.client.password}
nuxeo.audit.backend.green.opensearch1.client.trustStore.path=${nuxeo.audit.backend.default.opensearch1.client.trustStore.path}
nuxeo.audit.backend.green.opensearch1.client.trustStore.password=${nuxeo.audit.backend.default.opensearch1.client.trustStore.password}
nuxeo.audit.backend.green.opensearch1.client.trustStore.type=${nuxeo.audit.backend.default.opensearch1.client.trustStore.type}
nuxeo.audit.backend.green.opensearch1.client.keyStore.path=${nuxeo.audit.backend.default.opensearch1.client.keyStore.path}
nuxeo.audit.backend.green.opensearch1.client.keyStore.password=${nuxeo.audit.backend.default.opensearch1.client.keyStore.password}
nuxeo.audit.backend.green.opensearch1.client.keyStore.type=${nuxeo.audit.backend.default.opensearch1.client.keyStore.type}

nuxeo.audit.backend.green.opensearch1.settings.indexTranslogDurability=${nuxeo.audit.backend.default.opensearch1.settings.indexTranslogDurability}
nuxeo.audit.backend.green.opensearch1.settings.numberOfShards=${nuxeo.audit.backend.default.opensearch1.settings.numberOfShards}
nuxeo.audit.backend.green.opensearch1.settings.numberOfReplicas=${nuxeo.audit.backend.default.opensearch1.settings.numberOfReplicas}
nuxeo.audit.backend.green.opensearch1.settings.ignoreMalformed=${nuxeo.audit.backend.default.opensearch1.settings.ignoreMalformed}

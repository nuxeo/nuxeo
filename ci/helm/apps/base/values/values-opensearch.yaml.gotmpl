image:
  tag: 1.3.6
clusterName: opensearch
replicas: 1
singleNode: true
persistence:
  enabled: false
resources:
  requests:
    cpu: "1"
    memory: "4Gi"
  limits:
    memory: "4Gi"
opensearchJavaOpts: "-Xmx2g -Xms2g"
config:
  opensearch.yml:
    plugins:
      security:
        disabled: true
labels: {{- toYaml .Values.global.labels | nindent 2 }}
  dev.nuxeo.com/app: opensearch
  dev.nuxeo.com/resource: pod
service:
  labels: {{- toYaml .Values.global.labels | nindent 4 }}
    dev.nuxeo.com/app: opensearch
    dev.nuxeo.com/resource: service
extraObjects:
  - apiVersion: policy/v1
    kind: PodDisruptionBudget
    metadata:
      name: '{{"{{"}} template "opensearch.uname" . {{"}}"}}'
      labels:
        app.kubernetes.io/name: '{{"{{"}} include "opensearch.name" . {{"}}"}}'
        app.kubernetes.io/instance: '{{"{{"}} .Release.Name {{"}}"}}'
        app.kubernetes.io/managed-by: '{{"{{"}} .Release.Service {{"}}"}}'
        app.kubernetes.io/component: '{{"{{"}} include "opensearch.uname" . {{"}}"}}'
    spec:
      minAvailable: 1
      selector:
        matchLabels:
          app.kubernetes.io/name: '{{"{{"}} include "opensearch.name" . {{"}}"}}'
          app.kubernetes.io/instance: '{{"{{"}} .Release.Name {{"}}"}}'
{{- toYaml .Values.global.selectors | nindent 0 }}

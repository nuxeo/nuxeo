persistence:
  enabled: true
useStatefulSet: true
resources:
  requests:
    cpu: "15"
    memory: "56Gi"
  limits:
    cpu: "15"
    memory: "56Gi"
affinity:
  podAntiAffinity:
    requiredDuringSchedulingIgnoredDuringExecution:
    - labelSelector:
        matchExpressions:
        - key: dev.nuxeo.com/app
          operator: In
          values:
          - kafka
          - opensearch
          - mongodb
      topologyKey: "kubernetes.io/hostname"

resources:
  requests:
    cpu: "4"
    memory: "8Gi"
  limits:
    cpu: "4"
    memory: "8Gi"
podAnnotations:
  ad.datadoghq.com/tags: '{"service":"{{ env "SERVICE_TAG" | default "benchmark-local" }}"}'
affinity:
  # VersityGW (4 CPUs) cannot share a node with Nuxeo+Kafka (12+3=15 CPUs)
  # since benchmark nodes have 16 CPUs. Keep it away from all other benchmark
  # workloads so the scheduler places it on a node with available capacity.
  podAntiAffinity:
    requiredDuringSchedulingIgnoredDuringExecution:
    - labelSelector:
        matchExpressions:
        - key: dev.nuxeo.com/app
          operator: In
          values:
          - nuxeo
          - kafka
          - opensearch
          - mongodb
      topologyKey: "kubernetes.io/hostname"

repositories:
- name: opensearch
  url: https://opensearch-project.github.io/helm-charts/
- name: nuxeo
  url: https://packages.nuxeo.com/repository/helm-releases-public/

helmDefaults:
  timeout: 600
  wait: true

releases:
- name: nuxeo
  chart: nuxeo/nuxeo
  version: ~3.1.0
  namespace: {{ requiredEnv "NAMESPACE" }}
  condition: nuxeo.enabled
  {{- if or (or .Values.mongodb.enabled .Values.opensearch.enabled) .Values.kafka.enabled }}
  needs:
  {{- if .Values.mongodb.enabled }}
  - mongodb
  {{- end }}
  {{- if .Values.opensearch.enabled }}
  - opensearch
  {{- end }}
  {{- if .Values.kafka.enabled }}
  - kafka
  {{- end }}
  {{- if and (eq .Environment.Name "benchmark") (eq (env "USE_VERSITYGW" | default "false") "true") }}
  - versitygw
  {{- end }}
  {{- end }}
  values:
  - base/values/values-nuxeo.yaml.gotmpl
  # allows environment values override
  {{- with .Values.nuxeo }}
  - {{ toYaml . | nindent 4 }}
  {{- end }}
  # specific overrides
  {{- if eq .Environment.Name "benchmark" }}
  - base/values/benchmark/values-nuxeo.yaml.gotmpl
  {{- else if eq .Environment.Name "upgradeTest" }}
  - base/values/upgradeTest/values-nuxeo.yaml.gotmpl
  {{- end }}
- name: mongodb
  chart: oci://registry-1.docker.io/bitnamicharts/mongodb
  version: 16.1.1
  namespace: {{ requiredEnv "NAMESPACE" }}
  condition: mongodb.enabled
  values:
  - base/values/values-mongodb.yaml.gotmpl
  # allows environment values override
  {{- with .Values.mongodb }}
  - {{ toYaml . | nindent 4 }}
  {{- end }}
  # specific overrides
  {{- if eq .Environment.Name "benchmark" }}
  - base/values/benchmark/values-mongodb.yaml.gotmpl
  {{- end }}
- name: postgresql
  chart: oci://registry-1.docker.io/bitnamicharts/postgresql
  version: 15.5.28
  namespace: {{ requiredEnv "NAMESPACE" }}
  condition: postgresql.enabled
  values:
  - base/values/values-postgresql.yaml.gotmpl
  # allows environment values override
  {{- with .Values.postgresql }}
  - {{ toYaml . | nindent 4 }}
  {{- end }}
- name: opensearch
  chart: opensearch/opensearch
  version: 1.30.0
  namespace: {{ requiredEnv "NAMESPACE" }}
  condition: opensearch.enabled
  values:
  - base/values/values-opensearch.yaml.gotmpl
  # allows environment values override
  {{- with .Values.opensearch }}
  - {{ toYaml . | nindent 4 }}
  {{- end }}
  # specific overrides
  {{- if eq .Environment.Name "benchmark" }}
  - base/values/benchmark/values-opensearch.yaml.gotmpl
  {{- end }}
- name: kafka
  chart: oci://registry-1.docker.io/bitnamicharts/kafka
  version: 31.0.0
  namespace: {{ requiredEnv "NAMESPACE" }}
  condition: kafka.enabled
  values:
  - base/values/values-kafka.yaml.gotmpl
  # allows environment values override
  {{- with .Values.kafka }}
  - {{ toYaml . | nindent 4 }}
  {{- end }}
  # specific overrides
  {{- if eq .Environment.Name "benchmark" }}
  - base/values/benchmark/values-kafka.yaml.gotmpl
  {{- end }}
{{- if and (eq .Environment.Name "benchmark") (eq (env "USE_VERSITYGW" | default "false") "true") }}
# versitygw-init provisions the PVC and pre-creates the S3 bucket directory
# before VersityGW starts. The upstream versitygw chart reuses the PVC it
# creates (persistence.create=false) so the bucket is guaranteed to exist
# when VersityGW accepts its first request from Nuxeo.
- name: versitygw-init
  chart: ./versitygw-init
  namespace: {{ requiredEnv "NAMESPACE" }}
  values:
  - base/values/values-versitygw-init.yaml.gotmpl
  - base/values/benchmark/values-versitygw-init.yaml.gotmpl
- name: versitygw
  chart: oci://ghcr.io/versity/versitygw/charts/versitygw
  version: "0.3.5"
  namespace: {{ requiredEnv "NAMESPACE" }}
  needs:
  - versitygw-init
  values:
  - base/values/values-versitygw.yaml.gotmpl
  - base/values/benchmark/values-versitygw.yaml.gotmpl
{{- end }}

## DO NOT EDIT THIS FILE, USE nuxeo.conf  ##
nuxeo.template.includes=common
mongodb.target=.

nuxeo.db.type=mongodb
nuxeo.mongodb.server=localhost:27017
#nuxeo.mongodb.server=mongodb://[username:password@]host1[:port1][,host2[:port2],...[,hostN[:portN]]][/[database][?options]]
nuxeo.mongodb.dbname=nuxeo
# TLS/SSL configuration
nuxeo.mongodb.ssl=
nuxeo.mongodb.truststore.path=
nuxeo.mongodb.truststore.password=
nuxeo.mongodb.truststore.type=
nuxeo.mongodb.keystore.path=
nuxeo.mongodb.keystore.password=
nuxeo.mongodb.keystore.type=

# indexes creation
nuxeo.db.indexes.create=true

nuxeo.quartz.enable=true
org.quartz.jobStore.mongoOptionWriteConcernTimeoutMillis=5000
org.quartz.jobStore.mongoOptionWriteConcernW=Majority
# IMPORTANT: AWS DocumentDB Elastic clusters MUST set this to true.
# When true, the Quartz scheduler uses the driver's server-default write concern
# (ACKNOWLEDGED), so the MongoDB driver omits the writeConcern field from every
# command. DocumentDB Elastic rejects any command that carries writeConcern with
# error 303 "Field 'writeConcern' is currently not supported".
# When false (default), the scheduler uses the Majority write concern configured
# above, which is appropriate for standard MongoDB Replica Set deployments.
# Note: this property is only written to quartz.properties when set to true, so
# older quartz-mongodb versions (< 2.4.0) without the corresponding setter are
# not broken by the default value.
org.quartz.jobStore.mongoOptionUseServerDefaultWriteConcern=false

## MongoDB directories activation
nuxeo.mongodb.directories.enabled=true

## Cache Configuration ##
nuxeo.dbs.cache.enabled=true
nuxeo.dbs.cache.maxSize=1000
nuxeo.dbs.cache.concurrencyLevel=10
nuxeo.dbs.cache.ttl=10

## DBS Fulltext Configuration ##
nuxeo.dbs.fulltext.storedInBlobThreshold=0

# TransientDataStore default implementation
nuxeo.transientdatastore.default.provider.class=org.nuxeo.ecm.core.mongodb.ts.MongoDBTransientDataStore

## Startup checks configuration
mongodb.check.classpath=nxserver/lib:${nuxeo.home}/nxserver/bundles/nuxeo-{core-storage,runtime}-mongodb-*.jar
mongodb.check.class=org.nuxeo.ecm.core.storage.mongodb.MongoDBChecker
nuxeo.mongodb.check.timeout=5

## Use a MongoDB optimized transient store implementation
nuxeo.transientstore.provider=mongodb

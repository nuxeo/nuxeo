<?xml version="1.0"?>
<component name="org.nuxeo.ecm.core.migration.test.progress-reporting" version="1.0">

  <extension target="org.nuxeo.runtime.migration.MigrationService" point="configuration">
    <migration id="progress-reporting-bulk-migration">
      <description label="migration.progress.reporting.bulk">Progress Reporting Bulk Migration</description>
      <class>org.nuxeo.ecm.core.migrator.ProgressReportingBulkMigrator</class>
      <defaultState>before</defaultState>
      <state id="before">
        <description label="migration.progress.reporting.before">before progress reporting migration state</description>
      </state>
      <state id="after">
        <description label="migration.progress.reporting.after">after progress reporting migration state</description>
      </state>

      <step id="before-to-after" fromState="before" toState="after">
        <description label="migration.progress.reporting.before-to-after">Migrate progress reporting state from before to after</description>
      </step>
    </migration>
  </extension>

</component>

<?xml version="1.0"?>
<component name="org.nuxeo.contentTemplate.contrib.test.rootAclNoTemplate">

  <require>
    org.nuxeo.ecm.platform.content.template.service.ContentTemplateService.defaultContrib
  </require>

  <extension
    target="org.nuxeo.ecm.platform.content.template.service.ContentTemplateService"
    point="factoryBinding">

    <!-- Factory binding with ACLs but NO template children. -->
    <factoryBinding name="RootFactory" factoryName="SimpleTemplateRootFactory" targetType="Root">
      <acl>
        <ace principal="Administrator" permission="Everything" granted="true" />
        <ace principal="members" permission="Read" granted="true" />
        <ace principal="members" permission="Version" granted="true" />
      </acl>
      <!-- NO template children defined! -->
    </factoryBinding>

  </extension>

</component>

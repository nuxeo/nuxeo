<?xml version="1.0"?>
<!--
  Sets conflicting substringMatchType values on the two sub-directories of each
  multi-directory (subany on the primary, subfinal on the secondary). The resolver
  must pick the most permissive value (subany > subfinal > subinitial) and log a
  warning.
-->
<component name="org.nuxeo.ecm.platform.usermanager.tests.multi-directory.substring-match.conflicting-subs.mongodb">

  <require>org.nuxeo.ecm.platform.usermanager.tests.multi-directory-config</require>

  <extension target="org.nuxeo.directory.mongodb.MongoDBDirectoryFactory" point="directories">
    <directory name="userDirectory">
      <substringMatchType>subany</substringMatchType>
    </directory>
    <directory name="userDirectorySecondary">
      <substringMatchType>subfinal</substringMatchType>
    </directory>
    <directory name="groupDirectory">
      <substringMatchType>subany</substringMatchType>
    </directory>
    <directory name="groupDirectorySecondary">
      <substringMatchType>subfinal</substringMatchType>
    </directory>
  </extension>

</component>

<?xml version="1.0"?>
<component name="org.nuxeo.ecm.core.default.caches">

  <extension target="org.nuxeo.ecm.core.cache.CacheService" point="caches">
    <cache name="vocabulary-default-cache">
      <ttl>60</ttl><!-- minutes -->
      <option name="maxSize">1000</option>
      <option name="concurrencyLevel">10</option>
    </cache>

    <cache name="cache-vocabulary" copy="vocabulary-default-cache" />
    <cache name="cache-xvocabulary" copy="vocabulary-default-cache" />
    <cache name="cache-l10nxvocabulary" copy="vocabulary-default-cache" />
    <cache name="cache-documentsLists" copy="vocabulary-default-cache" />
  </extension>

</component>

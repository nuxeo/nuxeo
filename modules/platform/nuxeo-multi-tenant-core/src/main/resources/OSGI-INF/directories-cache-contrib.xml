<?xml version="1.0"?>
<component name="org.nuxeo.ecm.multi.tenant.cache.testsConfig">

  <extension target="org.nuxeo.ecm.core.cache.CacheService" point="caches">

    <cache name="multi-tenant-default-cache">
      <ttl>60</ttl><!-- minutes -->
      <option name="maxSize">1000</option>
    </cache>

    <cache name="tenants-cache" copy="multi-tenant-default-cache" />
    <cache name="tenants-cache-without-ref" copy="multi-tenant-default-cache" />
    <cache name="topic-cache-without-ref" copy="multi-tenant-default-cache" />
    <cache name="topic-cache" copy="multi-tenant-default-cache" />
    <cache name="subtopic-cache-without-ref" copy="multi-tenant-default-cache" />
    <cache name="subtopic-cache" copy="multi-tenant-default-cache" />
    <cache name="l10nsubjects-cache-without-ref" copy="multi-tenant-default-cache" />
    <cache name="l10nsubjects-cache" copy="multi-tenant-default-cache" />
    <cache name="l10ncoverage-cache-without-ref" copy="multi-tenant-default-cache" />
    <cache name="l10ncoverage-cache" copy="multi-tenant-default-cache" />

  </extension>

</component>
